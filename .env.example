# Urumi MCP Gateway - Local Development Environment Variables Example
# Copy this file to .env and fill in appropriate values. Never commit .env or secrets to git.

# Gateway Service Configuration
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0
GATEWAY_AUTH_SECRET=replace-with-a-secure-random-secret
DATABASE_URL=sqlite:///tmp/gateway.db

# Upstream WooCommerce Configuration
WOOCOMMERCE_BASE_URL=http://localhost:8080
WOOCOMMERCE_CONSUMER_KEY=ck_placeholder_for_local_store
WOOCOMMERCE_CONSUMER_SECRET=cs_placeholder_for_local_store

# LLM / Chat Configuration (for Dashboard agentic tool loop)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-placeholder

# Log level (debug, info, warn, error)
LOG_LEVEL=info
