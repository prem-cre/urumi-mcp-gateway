{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "store",
    "gatewayDatabase",
    "networkPolicy"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "environment",
        "storageClass"
      ],
      "properties": {
        "environment": {
          "enum": [
            "local",
            "production"
          ]
        },
        "storageClass": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "store": {
      "type": "object",
      "required": [
        "host",
        "url",
        "existingSecret",
        "wordpress",
        "database",
        "bootstrap"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "wordpress": {
          "$ref": "#/definitions/workload"
        },
        "database": {
          "$ref": "#/definitions/workload"
        },
        "bootstrap": {
          "type": "object",
          "required": [
            "enabled",
            "image",
            "woocommerceVersion",
            "resources"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "woocommerceVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        }
      }
    },
    "gatewayDatabase": {
      "$ref": "#/definitions/workload"
    },
    "gateway": {
      "type": "object",
      "required": ["enabled", "image", "imagePullPolicy", "existingSecret", "dashboardHost", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "existingSecret": {"type": "string", "minLength": 1},
        "adminEmail": {"type": "string", "format": "email"},
        "adminName": {"type": "string", "minLength": 1},
        "dashboardHost": {"type": "string", "minLength": 1},
        "mcpAllowedHosts": {"type": "array", "items": {"type": "string"}},
        "mcpAllowedOrigins": {"type": "array", "items": {"type": "string"}},
        "tlsSecretName": {"type": "string"},
        "sessionCookieSecure": {"type": "boolean"},
        "toolTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "discoveryTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "probeIntervalSeconds": {"type": "integer", "minimum": 5},
        "apiRpmLimit": {"type": "integer", "minimum": 1},
        "resources": {"type": "object", "required": ["requests", "limits"]}
      }
    },
    "demoMcp": {
      "type": "object",
      "required": ["enabled", "image", "existingSecret", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "existingSecret": {"type": "string", "minLength": 1},
        "resources": {"type": "object", "required": ["requests", "limits"]}
      }
    },
    "dashboard": {
      "type": "object",
      "required": ["enabled", "image", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "resources": {"type": "object", "required": ["requests", "limits"]}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "woocommerceMcp": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "existingSecret",
        "timezone",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        }
      }
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "required": [
        "image",
        "storage",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        }
      }
    }
  }
}
