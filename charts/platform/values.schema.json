{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "store",
    "gatewayDatabase",
    "networkPolicy"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "environment",
        "storageClass"
      ],
      "properties": {
        "environment": {
          "enum": [
            "local",
            "production"
          ]
        },
        "storageClass": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "store": {
      "type": "object",
      "required": [
        "host",
        "url",
        "existingSecret",
        "wordpress",
        "database",
        "bootstrap"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "wordpress": {
          "$ref": "#/definitions/workload"
        },
        "database": {
          "$ref": "#/definitions/workload"
        },
        "bootstrap": {
          "type": "object",
          "required": [
            "enabled",
            "image",
            "woocommerceVersion",
            "resources"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "image": {
              "type": "string",
              "minLength": 1
            },
            "woocommerceVersion": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            }
          }
        }
      }
    },
    "gatewayDatabase": {
      "$ref": "#/definitions/workload"
    },
    "gateway": {
      "type": "object",
      "required": ["enabled", "image", "imagePullPolicy", "existingSecret", "dashboardHost", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "imagePullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "existingSecret": {"type": "string", "minLength": 1},
        "adminEmail": {"type": "string", "format": "email"},
        "adminName": {"type": "string", "minLength": 1},
        "dashboardHost": {"type": "string", "minLength": 1},
        "mcpAllowedHosts": {"type": "array", "items": {"type": "string"}},
        "mcpAllowedOrigins": {"type": "array", "items": {"type": "string"}},
        "tlsSecretName": {"type": "string"},
        "sessionCookieSecure": {"type": "boolean"},
        "oidc": {
          "type": "object",
          "properties": {
            "issuerUrl": {"type": "string", "pattern": "^$|^https://"},
            "clientId": {"type": "string"},
            "redirectUrl": {"type": "string", "pattern": "^$|^https://|^http://localhost(:[0-9]+)?/|^http://([A-Za-z0-9-]+\\.)+localhost(:[0-9]+)?/"}
          }
        },
        "toolTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 60},
        "discoveryTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
        "probeIntervalSeconds": {"type": "integer", "minimum": 5},
        "apiRpmLimit": {"type": "integer", "minimum": 1},
        "circuitBreaker": {
          "type": "object",
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1, "maximum": 20},
            "cooldownSeconds": {"type": "number", "minimum": 1, "maximum": 300}
          }
        },
        "observability": {
          "type": "object",
          "properties": {
            "metricsEnabled": {"type": "boolean"},
            "metricsNamespaceSelectorLabels": {"type": "object", "additionalProperties": {"type": "string"}},
            "metricsPodSelectorLabels": {"type": "object", "additionalProperties": {"type": "string"}},
            "captureContent": {"type": "boolean"},
            "traceContentRetentionDays": {"type": "integer", "minimum": 1, "maximum": 30},
            "analysisPollSeconds": {"type": "number", "minimum": 1, "maximum": 30},
            "analysisLeaseSeconds": {"type": "integer", "minimum": 60, "maximum": 900},
            "analysisTimeoutSeconds": {"type": "number", "minimum": 5, "maximum": 180},
            "analysisMaxOutputTokens": {"type": "integer", "minimum": 256, "maximum": 4000},
            "analysisMaxTraces": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        },
        "llm": {
          "type": "object",
          "required": ["baseUrl", "model"],
          "properties": {
            "baseUrl": {"type": "string", "pattern": "^$|^https?://"},
            "model": {"type": "string"},
            "routerModel": {"type": "string"},
            "standardModel": {"type": "string"},
            "complexModel": {"type": "string"},
            "analysisModel": {"type": "string"},
            "providerName": {"type": "string"},
            "modelPricing": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["input_per_million", "output_per_million"],
                "properties": {
                  "input_per_million": {"type": "number", "minimum": 0},
                  "output_per_million": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        },
        "resources": {"type": "object", "required": ["requests", "limits"]}
      }
    },
    "demoMcp": {
      "type": "object",
      "required": ["enabled", "image", "existingSecret", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "existingSecret": {"type": "string", "minLength": 1},
        "resources": {"type": "object", "required": ["requests", "limits"]}
      }
    },
    "dashboard": {
      "type": "object",
      "required": ["enabled", "image", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string", "minLength": 1},
        "resources": {"type": "object", "required": ["requests", "limits"]}
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "woocommerceMcp": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "existingSecret",
        "timezone",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        }
      }
    }
  },
  "definitions": {
    "workload": {
      "type": "object",
      "required": [
        "image",
        "storage",
        "resources"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"
        },
        "resources": {
          "type": "object",
          "required": [
            "requests",
            "limits"
          ]
        }
      }
    }
  }
}
